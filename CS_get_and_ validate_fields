var need_timekeeping     = ZDK.Page.getField("Need_timekeeping").getValue();
var need_HR_Onboarding   = ZDK.Page.getField("Need_HR_Onboarding").getValue();
var need_HR_compliance    = ZDK.Page.getField("Need_HR_compliance").getValue();
