var contactLookup = ZDK.Page.getField("Contact_Name").getValue(); 

    // Verify a contact is actually selected on the Deal
    if (contactLookup == null || contactLookup === "" || !contactLookup.id) {
        ZDK.Client.showMessage("Error: Cannot find a contact record associated with this deal", { type: 'error' });
        return false;
    }

    try {
        // 2. Fetch the Contact record from the database using its ID
        var contactRecord = await ZDK.Apps.CRM.Contacts.fetchById(contactLookup.id);
        
        // 3. Extract the email (Default API name is "Email")
        var contactEmail = contactRecord.Email; 

        // 4. Validate if the email is missing
        if (contactEmail == null || contactEmail === "") {
            ZDK.Client.showMessage("Error: The associated Contact does not have an email address. Please update the Contact record.", { type: 'error' });
            return false;
        }

    } catch (error) {
        // Safeguard in case the API call fails or permissions block it
        ZDK.Client.showMessage("Error: Failed to verify Contact email details.", { type: 'error' });
        return false;
    }


let inputFields = [];
    inputFields.push({ type: 'text', label: 'Client ID' });

    inputFields.push({
        type: 'picklist',
        label: 'Is client known to you?',
        list_options: [
            { actual_value: 'Yes', display_value: 'Yes' },
            { actual_value: 'No', display_value: 'No' }
        ],
        value: ''
    });




let isValid = false;
let response;

// Loop to keep the prompt open if validation fails
while (!isValid) {
    response = ZDK.Client.getInput(inputFields, 'Please provide the following information', 'Send', 'Cancel');

    // 1. Check if user clicked 'Cancel' or closed the prompt
    if (!response) {
        return false; 
    }

    let clientId = response[0] ? response[0].toString().trim() : '';
    let knowClient = response[1] ? response[1].toString().trim() : '';

    // 2. Validation Logic
    if (clientId === '' || knowClient === '') {
        ZDK.Client.showMessage("Error: Both 'Client ID' and 'Is client known to you?' fields are required.", { type: 'error' });
        
        // Repopulate the fields so the user doesn't have to retype what they already entered
        inputFields[0].value = clientId;
        inputFields[1].value = knowClient;
        
        continue; // Restarts the loop, opening the input prompt again
    }

    // If both fields have values, break the loop
    isValid = true;
}

