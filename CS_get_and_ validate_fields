    return false;
}

if (need_HR_Onboarding == null || need_HR_Onboarding === "") {
    ZDK.Client.showMessage("Error: Please specify if you need HR Onboarding.", { type: 'error' });
    return false;
}

if (need_HR_compliance == null || need_HR_compliance === "") {
    ZDK.Client.showMessage("Error: Please specify if you need HR Compliance.", { type: 'error' });
    return false;
}

if (do_you_need_us_to_file_the == null || do_you_need_us_to_file_the === "") {
